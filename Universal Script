-- The gravity to go back to when you're not falling (respects the Gravity toggle below)
function Feather.Normal()
    return GravityEnabled and CurrentGravity or DefaultGravity
end

function Feather.Start()
    if Feather.Connection then
        return
    end

    Feather.Connection = RunService.Stepped:Connect(function()
        -- Look the root part up every step so respawning doesn't break it
        local Character = LocalPlayer.Character
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")

        local Target = Feather.Normal()
        if Root and Root.AssemblyLinearVelocity.Y < -Feather.FallSpeed then
            Target = Feather.Gravity
        end

        if Workspace.Gravity ~= Target then
            Workspace.Gravity = Target
        end
    end)
end

function Feather.Stop()
    if not Feather.Connection then
        return
    end

    Feather.Connection:Disconnect()
    Feather.Connection = nil
    Workspace.Gravity = Feather.Normal()
end


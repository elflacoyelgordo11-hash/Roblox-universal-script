local function GetMobileFlyInput()
    local viewportSize = Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
    local center = viewportSize / 2
    local delta = (LastTouchPosition - center) / Vector2.new(math.max(center.X, 1), math.max(center.Y, 1))

    return {
        X = math.clamp(delta.X * 2, -1, 1),
        Y = math.clamp(delta.Y * 2, -1, 1)
    }
end


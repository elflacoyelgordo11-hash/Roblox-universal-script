-- Character added event for maintaining speed/jump settings
LocalPlayer.CharacterAdded:Connect(function(character)
    local humanoid = character:WaitForChild("Humanoid")

    if SpeedEnabled then
        humanoid.WalkSpeed = CurrentSpeed
    end

    if JumpEnabled then
        if humanoid.UseJumpPower then
            humanoid.JumpPower = CurrentJump
        else
            humanoid.JumpHeight = CurrentJump
        end
    end
end)
local function NotifyExecutorCapabilities()
    local Missing = {}

    if not (Drawing and Drawing.new) then
        table.insert(Missing, "Drawing")
    end
    if not loadstring then
        table.insert(Missing, "loadstring")
    end
    if not game.HttpGet then
        table.insert(Missing, "HttpGet")
    end
    if not mousemoverel then
        table.insert(Missing, "mousemoverel")
    end
    if not setclipboard then
        table.insert(Missing, "clipboard")
    end

    if #Missing > 0 then
        Rayfield:Notify({
            Title = "Executor Compatibility",
            Content = "Missing: " .. table.concat(Missing, ", ") .. ". Some features may not work.",
            Duration = 6
        })
    end
end

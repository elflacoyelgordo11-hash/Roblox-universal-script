-- This stores what the GAME currently wants Lighting to be.
local GameLighting = {
    Brightness = Lighting.Brightness,
    ClockTime = Lighting.ClockTime,

    FogStart = Lighting.FogStart,
    FogEnd = Lighting.FogEnd,

    GlobalShadows = Lighting.GlobalShadows,

    Ambient = Lighting.Ambient,
    OutdoorAmbient = Lighting.OutdoorAmbient,

    ColorShift_Bottom = Lighting.ColorShift_Bottom,
    ColorShift_Top = Lighting.ColorShift_Top
}

local function UpdateGameLighting(Property)
    if LightingApplying then
        return
    end

    GameLighting[Property] = Lighting[Property]
end

local function SetupLightingWatcher(Property)
    LightingConnections[Property] =
        Lighting:GetPropertyChangedSignal(Property):Connect(function()
            UpdateGameLighting(Property)
        end)
end
-- Watch the Lighting properties that our features modify.
for _, Property in ipairs({
    "Brightness",
    "ClockTime",
    "FogStart",
    "FogEnd",
    "GlobalShadows",
    "Ambient",
    "OutdoorAmbient",
    "ColorShift_Bottom",
    "ColorShift_Top"
}) do
    SetupLightingWatcher(Property)
end

local function SetLighting(Property, Value)
    LightingApplying = true
    Lighting[Property] = Value
    LightingApplying = false
end

local function ApplyLightingOverrides()
    -- Fullbright
    if FullbrightEnabled then
        SetLighting("Brightness", 2)
        SetLighting("ClockTime", 14)
        SetLighting("GlobalShadows", false)

        SetLighting("Ambient", Color3.new(1, 1, 1))
        SetLighting("OutdoorAmbient", Color3.new(1, 1, 1))

        SetLighting("ColorShift_Bottom", Color3.new(0, 0, 0))
        SetLighting("ColorShift_Top", Color3.new(0, 0, 0))
    else
        -- Restore what the game currently wants
        SetLighting("Brightness", GameLighting.Brightness)
        SetLighting("ClockTime", GameLighting.ClockTime)
        SetLighting("GlobalShadows", GameLighting.GlobalShadows)

        SetLighting("Ambient", GameLighting.Ambient)
        SetLighting("OutdoorAmbient", GameLighting.OutdoorAmbient)

        SetLighting("ColorShift_Bottom", GameLighting.ColorShift_Bottom)
        SetLighting("ColorShift_Top", GameLighting.ColorShift_Top)
    end
    -- Remove Fog
    if RemoveFogEnabled then
        SetLighting("FogStart", 0)
        SetLighting("FogEnd", 9e9)
    else
        -- Restore what the game currently wants
        SetLighting("FogStart", GameLighting.FogStart)
        SetLighting("FogEnd", GameLighting.FogEnd)
    end
end

-- Cursor thing
local function CreateCustomCursor()
    local cursor
    local CursorGui
    local UsesDrawing = Drawing and Drawing.new

    if UsesDrawing then
        cursor = Drawing.new("Circle")
        cursor.Radius = 5
        cursor.Filled = true
        cursor.Color = Color3.fromRGB(255, 255, 255)
        cursor.Transparency = 1
        cursor.ZIndex = 999
        cursor.Visible = true
    else
        CursorGui = Instance.new("ScreenGui")
        CursorGui.Name = "CustomCursorGui"
        CursorGui.IgnoreGuiInset = true
        CursorGui.DisplayOrder = 999999
        CursorGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

        cursor = Instance.new("Frame")
        cursor.Name = "CustomCursorCircle"
        cursor.AnchorPoint = Vector2.new(0.5, 0.5)
        cursor.Size = UDim2.fromOffset(10, 10)
        cursor.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        cursor.BorderSizePixel = 0
        cursor.Parent = CursorGui

        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(1, 0)
        Corner.Parent = cursor
    end

    -- Update cursor position
    local connection = RunService.RenderStepped:Connect(function()
        local mousePos = UserInputService:GetMouseLocation()

        if UsesDrawing then
            cursor.Position = Vector2.new(mousePos.X, mousePos.Y)
        else
            cursor.Position = UDim2.fromOffset(mousePos.X, mousePos.Y)
        end
    end)
    -- Hide the default Roblox cursor
    UserInputService.MouseIconEnabled = false
    
    return {
        Cursor = cursor,
        CursorGui = CursorGui,
        UsesDrawing = UsesDrawing,
        Connection = connection,
        Remove = function(self)
            if self.UsesDrawing then
                self.Cursor:Remove()
            else
                self.CursorGui:Destroy()
            end
            self.Connection:Disconnect()
            UserInputService.MouseIconEnabled = true
        end
    }
end

local function EnableCustomCursor()
    if not customCursor then
        customCursor = CreateCustomCursor()
    end
end

local function DisableCustomCursor()
    if customCursor then
        customCursor:Remove()
        customCursor = nil
    end
end


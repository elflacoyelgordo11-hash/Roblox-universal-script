    local FakeLag = { Enabled = false, Delay = 2, Id = 0 }

    function FakeLag.Release()
        local Character = LocalPlayer.Character
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")
        if Root then
            Root.Anchored = false
        end
    end

    function FakeLag.Start()
        -- A new Id retires any loop that is still running, so loops never stack
        FakeLag.Id = FakeLag.Id + 1
        FakeLag.Enabled = true
        local Id = FakeLag.Id

        task.spawn(function()
            while FakeLag.Enabled and FakeLag.Id == Id do
                -- Look the root part up every cycle so respawning just works
                local Character = LocalPlayer.Character
                local Root = Character and Character:FindFirstChild("HumanoidRootPart")

                if Root then
                    Root.Anchored = true
                    task.wait(FakeLag.Delay)

                    if FakeLag.Enabled and FakeLag.Id == Id then
                        Root.Anchored = false
                    end
                end

                task.wait(0.05)
            end
        end)
    end

    function FakeLag.Stop()
        if not FakeLag.Enabled then
            return
        end

        FakeLag.Enabled = false
        FakeLag.Id = FakeLag.Id + 1
        FakeLag.Release()
    end

    MovementTab:CreateToggle({
        Name = "Fake Lag",
        CurrentValue = false,
        Flag = "FakeLag",
        Callback = function(Value)
            if Value then
                FakeLag.Start()
            else
                FakeLag.Stop()
            end
        end,
    })

    MovementTab:CreateSlider({
        Name = "Fake Lag Delay",
        Range = {0.1, 5},
        Increment = 0.1,
        Suffix = "s",
        CurrentValue = 2,
        Flag = "FakeLagDelay",
        Callback = function(Value)
            FakeLag.Delay = Value
        end,
    })

    table.insert(ExtraCleanups, FakeLag.Stop)
end
-- Player Collision
do
    local PC = {
        Enabled = false,
        Full = false,       -- collide with every part instead of just head/torso/root
        Query = "",         -- blank = everyone, otherwise a name or display name prefix
        Generation = 0,     -- bumped on every apply/clear so stale work stops itself
        Connections = {},
        Parts = setmetatable({}, { __mode = "k" }),
        Allowed = { "Head", "Torso", "UpperTorso", "HumanoidRootPart" },
    }

    function PC.Matches(Player)
        if Player == LocalPlayer then
            return false
        end

        local Query = PC.Query:lower()
        if Query == "" or Query == "all" or Query == "others" then
            return true
        end

        return Player.Name:lower():sub(1, #Query) == Query
            or Player.DisplayName:lower():sub(1, #Query) == Query
    end
    -- Invisible solid copy of a part, welded on, that doesn't collide with the original
    function PC.AddCollidable(Part)
        local Collidable = Instance.new("Part")
        Collidable.Name = "__COLLIDABLE"
        Collidable.Size = Part.Size
        Collidable.Transparency = 1

        local NoCollide = Instance.new("NoCollisionConstraint")
        NoCollide.Part0 = Part
        NoCollide.Part1 = Collidable
        NoCollide.Parent = Collidable

        local Weld = Instance.new("Weld")
        Weld.Part0 = Part
        Weld.Part1 = Collidable
        Weld.Parent = Collidable

        Collidable.Parent = Part
        PC.Parts[Collidable] = true
    end

    function PC.Collidable(Character, Generation)
        if not Character or Character == LocalPlayer.Character then
            return
        end
        -- A freshly spawned character may not be in the workspace yet
        for _ = 1, 20 do
            if Character.Parent then
                break
            end
            task.wait(0.1)
        end
        if not Character.Parent or PC.Generation ~= Generation then
            return
        end

        local Count = 0
        local function Add(Part)
            if PC.Generation ~= Generation or not Part.Parent then
                return
            end

            PC.AddCollidable(Part)
            -- Pause every so often to avoid a lag spike
            Count = Count + 1
            if Count % 20 == 0 then
                task.wait()
            end
        end

        if PC.Full then
            for _, Descendant in ipairs(Character:GetDescendants()) do
                if Descendant:IsA("BasePart") and Descendant.Name ~= "__COLLIDABLE" then
                    Add(Descendant)
                end
            end
        else
            for _, Name in ipairs(PC.Allowed) do
                local Found = Character:FindFirstChild(Name)
                if Found and Found:IsA("BasePart") then
                    Add(Found)
                end
            end
        end

        if PC.Generation ~= Generation then
            return
        end
        -- Also cover parts that show up later (accessories, respawned limbs)
        table.insert(PC.Connections, Character.DescendantAdded:Connect(function(Child)
            -- Skip our own colliders, otherwise full mode would keep copying them forever
            if not Child:IsA("BasePart") or Child.Name == "__COLLIDABLE" then
                return
            end

            if not PC.Full and (Child.Parent ~= Character or not table.find(PC.Allowed, Child.Name)) then
                return
            end

            Add(Child)
        end))
    end

    function PC.Clear()
        PC.Generation = PC.Generation + 1

        for _, Connection in ipairs(PC.Connections) do
            Connection:Disconnect()
        end
        table.clear(PC.Connections)

        for Part in pairs(PC.Parts) do
            Part:Destroy()
        end
        table.clear(PC.Parts)
    end

    function PC.Apply()
        PC.Clear()
        local Generation = PC.Generation

        local function Hook(Player)
            if not PC.Matches(Player) then
                return
            end

            if Player.Character then
                task.spawn(PC.Collidable, Player.Character, Generation)
            end

            table.insert(PC.Connections, Player.CharacterAdded:Connect(function(Character)
                PC.Collidable(Character, Generation)
            end))
        end

        for _, Player in ipairs(Players:GetPlayers()) do
            Hook(Player)
        end
        table.insert(PC.Connections, Players.PlayerAdded:Connect(Hook))
    end

    MovementTab:CreateToggle({
        Name = "Player Collision",
        CurrentValue = false,
        Flag = "PlayerCollision",
        Callback = function(Value)
            PC.Enabled = Value
            if Value then
                PC.Apply()
            else
                PC.Clear()
            end
        end,
    })

    MovementTab:CreateToggle({
        Name = "Full Body Collision",
        CurrentValue = false,
        Flag = "PlayerCollisionFull",
        Callback = function(Value)
            PC.Full = Value
            if PC.Enabled then
                PC.Apply()
            end
        end,
    })

    MovementTab:CreateInput({
        Name = "Collision Target",
        PlaceholderText = "blank = everyone, or a player name",
        RemoveTextAfterFocusLost = false,
        Callback = function(Text)
            PC.Query = (Text or ""):match("^%s*(.-)%s*$")
            if PC.Enabled then
                PC.Apply()
            end
        end,
    })

    table.insert(ExtraCleanups, PC.Clear)
end


-- Walk To Player
local function StopFollowPath()
    if FollowPathBlockedConnection then
        FollowPathBlockedConnection:Disconnect()
        FollowPathBlockedConnection = nil
    end

    FollowPath = nil
    FollowWaypoints = {}
    FollowWaypointIndex = 1
    FollowTargetPosition = nil
    FollowLastJump = 0
end

local function CreateFollowPath(StartPosition, TargetPosition)
    local Path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 3
    })

    local Success = pcall(function()
        Path:ComputeAsync(StartPosition, TargetPosition)
    end)

    if Success and Path.Status == Enum.PathStatus.Success then
        return Path
    end

    return nil
end

local function CalculateFollowPath()
    local Character = LocalPlayer.Character
    local Target = SelectedPlayer and Players:FindFirstChild(SelectedPlayer)

    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    local TargetRoot = Target
        and Target.Character
        and Target.Character:FindFirstChild("HumanoidRootPart")

    if not Root or not TargetRoot then
        return false
    end

    local Path = CreateFollowPath(
        Root.Position,
        TargetRoot.Position
    )

    if not Path then
        return false
    end

    if FollowPathBlockedConnection then
        FollowPathBlockedConnection:Disconnect()
        FollowPathBlockedConnection = nil
    end

    FollowPath = Path
    FollowWaypoints = Path:GetWaypoints()
    FollowWaypointIndex = 2
    FollowTargetPosition = TargetRoot.Position

    FollowPathBlockedConnection = Path.Blocked:Connect(function(BlockedIndex)
        if BlockedIndex >= FollowWaypointIndex then
            FollowLastRepath = 0
        end
    end)

    return #FollowWaypoints > 0
end

OthersTab:CreateToggle({
    Name = "Walk to Player",
    CurrentValue = false,
    Flag = "FollowPlayer",

    Callback = function(Value)
        FollowEnabled = Value

        if FollowConnection then
            FollowConnection:Disconnect()
            FollowConnection = nil
        end

        StopFollowPath()

        if not Value then
            return
        end

        FollowConnection = RunService.Heartbeat:Connect(function()
            if not FollowEnabled then
                return
            end

            local Character = LocalPlayer.Character
            local Target = SelectedPlayer and Players:FindFirstChild(SelectedPlayer)

            local Humanoid = Character
                and Character:FindFirstChildOfClass("Humanoid")

            local Root = Character
                and Character:FindFirstChild("HumanoidRootPart")

            local TargetRoot = Target
                and Target.Character
                and Target.Character:FindFirstChild("HumanoidRootPart")

            if not Humanoid or not Root or not TargetRoot then
                return
            end

            local Distance = (Root.Position - TargetRoot.Position).Magnitude

            -- Keep walking toward them when close.
            if Distance <= 5 then
                Humanoid:MoveTo(TargetRoot.Position)
                return
            end

            local TargetMoved =
                not FollowTargetPosition
                or (TargetRoot.Position - FollowTargetPosition).Magnitude > 6

            local PathFinished =
                not FollowPath
                or FollowWaypointIndex > #FollowWaypoints

            local PathOld = FollowPath
                and os.clock() - FollowLastRepath > 2
            -- Continuously create new paths as the target moves.
            local State = Humanoid:GetState()
            local IsAirborne = State == Enum.HumanoidStateType.Jumping
                or State == Enum.HumanoidStateType.Freefall

            if (PathFinished or ((TargetMoved or PathOld) and not IsAirborne))
                and os.clock() - FollowLastRepath > 0.2 then

                FollowLastRepath = os.clock()
                CalculateFollowPath()
            end

            local Waypoint = FollowWaypoints[FollowWaypointIndex]

            if Waypoint then
                local WaypointDistance = (Root.Position - Waypoint.Position).Magnitude

                if Waypoint.Action == Enum.PathWaypointAction.Jump
                    and WaypointDistance <= 6 then
                    if os.clock() - FollowLastJump > 0.6 then
                        FollowLastJump = os.clock()
                        Humanoid.Jump = true
                        Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                    end
                end

                Humanoid:MoveTo(Waypoint.Position)

                if WaypointDistance <= 3 then
                    FollowWaypointIndex += 1
                end
            else
                -- Never stop just because the path ended.
                Humanoid:MoveTo(TargetRoot.Position)
            end
        end)
    end
})


    local Target = GetClosestTarget()

    if not Target then
        return
    end

    local ScreenPosition, OnScreen =
        Camera:WorldToViewportPoint(Target.Position)

    if not OnScreen then
        return
    end
    -- Higher Smoothness = slower/smoother movement
    local AimAmount = 1 - Smoothness

    if AimMethod == "Mouse" then
        if mousemoverel then
            local MousePosition = UserInputService:GetMouseLocation()

            local TargetPosition = Vector2.new(
                ScreenPosition.X,
                ScreenPosition.Y
            )

            local Difference = TargetPosition - MousePosition

            mousemoverel(
                Difference.X * AimAmount,
                Difference.Y * AimAmount
            )
        end
    else
        local TargetCFrame = CFrame.lookAt(
            Camera.CFrame.Position,
            Target.Position
        )

        Camera.CFrame = Camera.CFrame:Lerp(
            TargetCFrame,
            AimAmount
        )
    end
end)


local function CreateESP(Player, ObjectTable, Prefix)
    if Player == LocalPlayer or ObjectTable[Player] then
        return
    end

    local Highlight = Instance.new("Highlight")
    Highlight.Name = Prefix .. "_ESP"
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.Enabled = false
    Highlight.FillTransparency = 0.5
    Highlight.OutlineTransparency = 0.3

    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = Prefix .. "_ESPName"
    Billboard.AlwaysOnTop = true
    Billboard.Size = UDim2.new(0, 200, 0, 50)
    Billboard.StudsOffset = Vector3.new(0, 3, 0)
    Billboard.Enabled = false

    local NameLabel = Instance.new("TextLabel")
    NameLabel.BackgroundTransparency = 1
    NameLabel.Size = UDim2.new(1, 0, 0.5, 0)
    NameLabel.Font = Enum.Font.SourceSansBold
    NameLabel.TextSize = 14
    NameLabel.Text = Player.Name
    NameLabel.TextStrokeTransparency = 0
    NameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    NameLabel.Parent = Billboard

    local DistanceLabel = Instance.new("TextLabel")
    DistanceLabel.BackgroundTransparency = 1
    DistanceLabel.Position = UDim2.new(0, 0, 0.5, 0)
    DistanceLabel.Size = UDim2.new(1, 0, 0.5, 0)
    DistanceLabel.Font = Enum.Font.SourceSans
    DistanceLabel.TextSize = 12
    DistanceLabel.Text = "0 studs"
    DistanceLabel.TextStrokeTransparency = 0
    DistanceLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    DistanceLabel.Parent = Billboard

    ObjectTable[Player] = {
        Highlight = Highlight,
        Billboard = Billboard,
        NameLabel = NameLabel,
        DistanceLabel = DistanceLabel,
        BodyPartBoxes = {}
    }
end

local function ClearBodyPartBoxes(ESP)
    for Part, Box in pairs(ESP.BodyPartBoxes) do
        Box:Destroy()
        ESP.BodyPartBoxes[Part] = nil
    end
end

local function UpdateBodyPartBoxes(Character, ESP, Color, Transparency)
    local CurrentParts = {}

    for _, Part in ipairs(Character:GetDescendants()) do
        if Part:IsA("BasePart") and Part.Transparency < 1 then
            CurrentParts[Part] = true

            local Box = ESP.BodyPartBoxes[Part]

            if not Box then
                Box = Instance.new("BoxHandleAdornment")
                Box.Name = "BodyPartESP"
                Box.Adornee = Part
                Box.AlwaysOnTop = true
                Box.ZIndex = 5
                Box.Parent = Part
                ESP.BodyPartBoxes[Part] = Box
            end

            Box.Size = Part.Size
            Box.Color3 = Color
            Box.Transparency = math.clamp(Transparency + 0.2, 0, 1)
        end
    end

    for Part, Box in pairs(ESP.BodyPartBoxes) do
        if not CurrentParts[Part] then
            Box:Destroy()
            ESP.BodyPartBoxes[Part] = nil
        end
    end
end

local function AttachESP(Player, ESP)
    local Character = Player.Character

    if not Character then
        return
    end

    ESP.Highlight.Adornee = Character
    ESP.Highlight.Parent = Character

    local Head = Character:FindFirstChild("Head")
        or Character:FindFirstChild("UpperTorso")
        or Character:FindFirstChild("Torso")

    if Head then
        ESP.Billboard.Parent = Head
    end
end

local function UpdateESPObject(Player, ESP, Enabled, Color, Transparency, UseBodyPartFallback)
    local Character = Player.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local Root = Character and (
        Character:FindFirstChild("HumanoidRootPart")
        or Character:FindFirstChild("UpperTorso")
        or Character:FindFirstChild("Torso")
        or Character.PrimaryPart
    )

    if Character and not Root then
        Root = Character:FindFirstChildWhichIsA("BasePart", true)
    end

    if not Enabled or not Character or not Root or (Humanoid and Humanoid.Health <= 0) then
        ESP.Highlight.Enabled = false
        ESP.Billboard.Enabled = false
        ClearBodyPartBoxes(ESP)
        return
    end

    local FinalColor = Color

    if Player == LocalPlayer then
        return
    end

    ESP.Highlight.FillColor = FinalColor
    ESP.Highlight.OutlineColor = FinalColor
    ESP.Highlight.FillTransparency = Transparency
    ESP.Highlight.OutlineTransparency = math.max(0, Transparency - 0.2)

    ESP.NameLabel.TextColor3 = FinalColor
    ESP.DistanceLabel.TextColor3 = FinalColor

    local MyCharacter = LocalPlayer.Character
    local MyRoot = MyCharacter and MyCharacter:FindFirstChild("HumanoidRootPart")

    if MyRoot then
        local Distance = math.floor(
            (MyRoot.Position - Root.Position).Magnitude
        )

        ESP.DistanceLabel.Text = tostring(Distance) .. " studs"
    end

    if ESP.Highlight.Parent ~= Character then
        ESP.Highlight.Parent = Character
    end

    if ESP.Highlight.Adornee ~= Character then
        ESP.Highlight.Adornee = Character
    end

    local Head = Character:FindFirstChild("Head")
        or Character:FindFirstChild("UpperTorso")
        or Character:FindFirstChild("Torso")
        or Root

    if Head and ESP.Billboard.Parent ~= Head then
        ESP.Billboard.Parent = Head
    end

    if UseBodyPartFallback then
        ESP.Highlight.Enabled = false
        UpdateBodyPartBoxes(Character, ESP, FinalColor, Transparency)
    else
        ClearBodyPartBoxes(ESP)
        ESP.Highlight.Enabled = true
    end
    ESP.Billboard.Enabled = true
end

local function SetupESPPlayer(Player)
    if Player == LocalPlayer then
        return
    end

    CreateESP(Player, ESPObjects, "MOUSED")
    CreateESP(Player, TeamESPObjects, "MOUSED_Team")

    Player.CharacterAdded:Connect(function(Character)
        task.wait(0.2)

        local Normal = ESPObjects[Player]
        local Team = TeamESPObjects[Player]

        if Normal then
            AttachESP(Player, Normal)
        end

        if Team then
            AttachESP(Player, Team)
        end
    end)
end

local function UpdateNormalESP()
    local HighlightCount = 0

    for Player, ESP in pairs(ESPObjects) do
        local Color = ESPColor

        if RainbowESP then
            Color = Color3.fromHSV((tick() % 5) / 5, 1, 1)
        end

        UpdateESPObject(
            Player,
            ESP,
            ESPEnabled,
            Color,
            ESPTransparency,
            HighlightCount >= 31
        )

        if HighlightCount < 31 then
            HighlightCount = HighlightCount + 1
        end
    end
end

local function UpdateTeamESP()
    for Player, ESP in pairs(TeamESPObjects) do
        local Color

        if LocalPlayer.Team and Player.Team == LocalPlayer.Team then
            Color = TeamESPColor
        else
            Color = OpponentESPColor
        end

        UpdateESPObject(
            Player,
            ESP,
            TeamESPEnabled,
            Color,
            TeamESPTransparency
        )
    end
end

local function EnableNormalESP()

    Callback = function()
        local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        local Character = LocalPlayer.Character

        if not Backpack then
            return
        end

        local ExistingTool = Backpack:FindFirstChild("Click Tween")
            or (Character and Character:FindFirstChild("Click Tween"))

        if ExistingTool then
            ExistingTool:Destroy()
        end

        local Tool = Instance.new("Tool")
        Tool.Name = "Click Tween"
        Tool.RequiresHandle = false
        Tool.CanBeDropped = false

        Tool.Activated:Connect(function()
            local Mouse = LocalPlayer:GetMouse()
            local CurrentCharacter = LocalPlayer.Character
            local Root = CurrentCharacter and CurrentCharacter:FindFirstChild("HumanoidRootPart")

            if not Mouse.Hit or not Root then
                return
            end

            local TargetPosition = Mouse.Hit.Position + Vector3.new(0, 3, 0)
            local Distance = (Root.Position - TargetPosition).Magnitude
            local Duration = math.max(Distance / math.max(TweenSpeed, 1), 0.1)
            local Tween = TweenService:Create(
                Root,
                TweenInfo.new(Duration, Enum.EasingStyle.Linear),
                {CFrame = CFrame.new(TargetPosition)}
            )

            Tween:Play()
        end)

        Tool.Parent = Backpack
    end
})


local function NotifyWelderCompatibility()
    local Missing = {}
    local Warnings = {}

    local MobileMode = UserInputService and (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled)

    if not RunService or not RunService.Heartbeat then
        table.insert(Missing, "RunService.Heartbeat")
    end
    if not Players or not Players.LocalPlayer then
        table.insert(Missing, "LocalPlayer")
    end
    if not sethiddenproperty then
        table.insert(Missing, "sethiddenproperty")
    end

    local Character = Players and Players.LocalPlayer and Players.LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local Root = Character and (
        Character:FindFirstChild("HumanoidRootPart")
        or Character:FindFirstChild("RootPart")
        or Character:FindFirstChild("Torso")
        or Character:FindFirstChild("UpperTorso")
        or Character:FindFirstChild("LowerTorso")
        or Character:FindFirstChild("Head")
    )

    if not Character then
        table.insert(Missing, "Character")
    end
    if not Humanoid then
        table.insert(Missing, "Humanoid")
    end
    if not Root then
        table.insert(Missing, "Rig Root")
    end
    if Character and not Character:FindFirstChildWhichIsA("Animator", true) then
        table.insert(Warnings, "Animator missing")
    end
    if MobileMode then
        table.insert(Warnings, "Mobile mode: some keyboard-only features may be limited")
    end

    local Content = ""
    if #Missing > 0 then
        Content = "Missing: " .. table.concat(Missing, ", ") .. ". Some weld features may fail."
    elseif #Warnings > 0 then
        Content = "Compatible with current rig. " .. table.concat(Warnings, "; ") .. "."
    else
        Content = "Compatible with current rig and executor support."
    end

    Rayfield:Notify({
        Title = "Welder Compatibility",
        Content = Content,
        Duration = 6
    })
end

local function NotifyExecutorCapabilities()
    local Missing = {}

    if not (Drawing and Drawing.new) then
        table.insert(Missing, "Drawing")
    end
    if not loadstring then
        table.insert(Missing, "loadstring")
    end
    if not game.HttpGet then
        table.insert(Missing, "HttpGet")
    end
    if not mousemoverel then
        table.insert(Missing, "mousemoverel")
    end
    if not setclipboard then
        table.insert(Missing, "clipboard")
    end

    if #Missing > 0 then
        Rayfield:Notify({
            Title = "Executor Compatibility",
            Content = "Missing: " .. table.concat(Missing, ", ") .. ". Some features may not work.",
            Duration = 6
        })
    end
end

local function StartVehicleFly()
    StopVehicleFly()

    VehicleFlyConnection = RunService.Heartbeat:Connect(function()
        local Character = LocalPlayer.Character
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        local Seat = Humanoid and Humanoid.SeatPart
        local VehicleRoot = Seat and Seat:IsA("VehicleSeat") and Seat.AssemblyRootPart

        if not VehicleRoot then
            if VehicleFlyBodyVelocity then
                VehicleFlyBodyVelocity:Destroy()
                VehicleFlyBodyVelocity = nil
            end
            if VehicleFlyBodyGyro then
                VehicleFlyBodyGyro:Destroy()
                VehicleFlyBodyGyro = nil
            end
            return
        end

        if not VehicleFlyBodyVelocity or VehicleFlyBodyVelocity.Parent ~= VehicleRoot then
            if VehicleFlyBodyVelocity then
                VehicleFlyBodyVelocity:Destroy()
            end

            VehicleFlyBodyVelocity = Instance.new("BodyVelocity")
            VehicleFlyBodyVelocity.Name = "MOUSED_VehicleFlyVelocity"
            VehicleFlyBodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            VehicleFlyBodyVelocity.P = 5000
            VehicleFlyBodyVelocity.Parent = VehicleRoot
        end

        if not VehicleFlyBodyGyro or VehicleFlyBodyGyro.Parent ~= VehicleRoot then
            if VehicleFlyBodyGyro then
                VehicleFlyBodyGyro:Destroy()
            end

            VehicleFlyBodyGyro = Instance.new("BodyGyro")
            VehicleFlyBodyGyro.Name = "MOUSED_VehicleFlyGyro"
            VehicleFlyBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
            VehicleFlyBodyGyro.P = 5000
            VehicleFlyBodyGyro.Parent = VehicleRoot
        end

        local CameraCFrame = Camera.CFrame
        local Forward = Vector3.new(CameraCFrame.LookVector.X, 0, CameraCFrame.LookVector.Z)
        local Right = Vector3.new(CameraCFrame.RightVector.X, 0, CameraCFrame.RightVector.Z)
        local Horizontal = Vector3.zero
        local Vertical = 0

        if Forward.Magnitude > 0 then
            Forward = Forward.Unit
            VehicleFlyBodyGyro.CFrame = CFrame.lookAt(
                VehicleRoot.Position,
                VehicleRoot.Position + Forward
            )
        end
        if Right.Magnitude > 0 then
            Right = Right.Unit
        end

        if IsMobileInput() then
            local TouchInput = GetMobileFlyInput()
            Horizontal = (Forward * (-TouchInput.Y)) + (Right * TouchInput.X)
            Vertical = math.clamp(TouchInput.Y * 2, -1, 1)
        else
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then Horizontal += Forward end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then Horizontal -= Forward end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then Horizontal += Right end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then Horizontal -= Right end
            if UserInputService:IsKeyDown(Enum.KeyCode.E) then Vertical += 1 end
            if UserInputService:IsKeyDown(Enum.KeyCode.Q) then Vertical -= 1 end
        end

        if Horizontal.Magnitude > 1 then
            Horizontal = Horizontal.Unit
        end

        VehicleFlyBodyVelocity.Velocity = Horizontal * VehicleFlySpeed
            + Vector3.new(0, Vertical * VehicleFlySpeed, 0)
    end)
end

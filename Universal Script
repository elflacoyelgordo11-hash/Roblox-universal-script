local function GetHumanoid()
    local Character = LocalPlayer.Character
    if not Character then
        return nil
    end

    return Character:FindFirstChildOfClass("Humanoid")
end

local function ApplySpeed()
    local Humanoid = GetHumanoid()
    if not Humanoid or not SpeedEnabled then
        return
    end

    local Original = OriginalMovementValues[Humanoid]

    if not Original then
        Original = {
            WalkSpeed = Humanoid.WalkSpeed,
            JumpPower = Humanoid.JumpPower,
            JumpHeight = Humanoid.JumpHeight
        }
        OriginalMovementValues[Humanoid] = Original
    end

    Humanoid.WalkSpeed = CurrentSpeed
end

local function ApplyJump()
    local Humanoid = GetHumanoid()
    if not Humanoid or not JumpEnabled then
        return
    end

    local Original = OriginalMovementValues[Humanoid]

    if not Original then
        Original = {
            WalkSpeed = Humanoid.WalkSpeed,
            JumpPower = Humanoid.JumpPower,
            JumpHeight = Humanoid.JumpHeight
        }
        OriginalMovementValues[Humanoid] = Original
    end

    if Humanoid.UseJumpPower then
        Humanoid.JumpPower = CurrentJump
    else
        Humanoid.JumpHeight = CurrentJump
    end
end

local function RestoreMovement()
    local Humanoid = GetHumanoid()
    local Original = Humanoid and OriginalMovementValues[Humanoid]

    if not Humanoid or not Original then
        return
    end

    Humanoid.WalkSpeed = Original.WalkSpeed
    Humanoid.JumpPower = Original.JumpPower
    Humanoid.JumpHeight = Original.JumpHeight
    OriginalMovementValues[Humanoid] = nil
end

local function UpdateMovement()
    if SpeedEnabled then
        ApplySpeed()
    end

    if JumpEnabled then
        ApplyJump()
    end
end

local function UpdateMovementConnection()
    if SpeedEnabled or JumpEnabled then
        if not MovementMaintenanceConnection then
            MovementMaintenanceConnection = RunService.Heartbeat:Connect(UpdateMovement)
        end
    elseif MovementMaintenanceConnection then
        MovementMaintenanceConnection:Disconnect()
        MovementMaintenanceConnection = nil
    end
end

local function StopFly()
    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end

    if FlyBodyVelocity then
        FlyBodyVelocity:Destroy()
        FlyBodyVelocity = nil
    end

    if FlyBodyGyro then
        FlyBodyGyro:Destroy()
        FlyBodyGyro = nil
    end
end

local function StartFly()
    StopFly()

    FlyConnection = RunService.Heartbeat:Connect(function()
        local Character = LocalPlayer.Character
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")

        if not Root then
            return
        end

        if not FlyBodyVelocity or FlyBodyVelocity.Parent ~= Root then
            FlyBodyVelocity = Instance.new("BodyVelocity")
            FlyBodyVelocity.Name = "MOUSED_FlyVelocity"
            FlyBodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            FlyBodyVelocity.P = 5000
            FlyBodyVelocity.Parent = Root
        end

        if not FlyBodyGyro or FlyBodyGyro.Parent ~= Root then
            FlyBodyGyro = Instance.new("BodyGyro")
            FlyBodyGyro.Name = "MOUSED_FlyGyro"
            FlyBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
            FlyBodyGyro.P = 5000
            FlyBodyGyro.Parent = Root
        end

        local CameraCFrame = Camera.CFrame
        local Forward = Vector3.new(
            CameraCFrame.LookVector.X,
            0,
            CameraCFrame.LookVector.Z
        )
        local Right = Vector3.new(
            CameraCFrame.RightVector.X,
            0,
            CameraCFrame.RightVector.Z
        )
        local Horizontal = Vector3.zero
        local Vertical = 0

        if Forward.Magnitude > 0 then
            FlyBodyGyro.CFrame = CFrame.lookAt(
                Root.Position,
                Root.Position + Forward.Unit
            )
        end

        if IsMobileInput() then
            local touchInput = GetMobileFlyInput()
            local moveX = touchInput.X
            local moveY = touchInput.Y

            Horizontal = (Forward * (-moveY)) + (Right * moveX)
            Vertical = math.clamp(moveY * 2, -1, 1)
        else
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                Horizontal += Forward
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                Horizontal -= Forward
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                Horizontal += Right
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                Horizontal -= Right
            end

            if UserInputService:IsKeyDown(Enum.KeyCode.E) then
                Vertical += 1
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Q) then
                Vertical -= 1
            end
        end

        if Horizontal.Magnitude > 1 then
            Horizontal = Horizontal.Unit
        end

        FlyBodyVelocity.Velocity = Horizontal * FlySpeed
            + Vector3.new(0, Vertical * FlySpeed, 0)
    end)
end


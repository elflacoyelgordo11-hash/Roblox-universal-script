do
    local TextChatService = game:GetService("TextChatService")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Rng = Random.new()
    local AutoToggle
    local Uwu = { Auto = false, Connection = nil, Ignore = {} }
    -- Same substitutions, in the same order
    local Rules = {
        { "r", "w" }, { "R", "W" },
        { "l", "w" }, { "L", "W" },
        { "n", "ny" }, { "N", "Ny" },
        { "ove", "uv" }, { "OVE", "UV" },
        { "th", "d" }, { "Th", "D" }, { "TH", "D" },
        { "v", "w" }, { "V", "W" },
        { "you", "youw" }, { "You", "Youw" },
    }

    local Affixes = {
        " :3", " >:3", " :333", " :3c", "!11!!", "!!!!", "!!!", "~~", "!!??!", "?!?!??",
        " >w<", " >.<", " owo", " OwO", " UwU", " nyaa~", " ^w^", " <3", " x3", " muah~",
        " :D", " hehe", " rawr", " prrr~", " ✧w✧", " hehehehe", " chu~", " ~nya", " kawaii~",
        " yay!!", " :DD", " *excited noises*", " wheee~~", " eheheheheheheh!",
        " heheheheh!!", " uheheheheheh!!", " uehh",
    }

    function Uwu.Transform(Input)
        local Result = tostring(Input or "")

        for _, Rule in ipairs(Rules) do
            Result = string.gsub(Result, Rule[1], Rule[2])
        end
        -- Random stutter: "hello" -> "h-hello"
        local Chars = {}
        for i = 1, #Result do
            local Char = Result:sub(i, i)
            if Char:match("[a-zA-Z]") and Rng:NextNumber() > 0.7 then
                table.insert(Chars, Char .. "-")
            end
            table.insert(Chars, Char)
        end
        local Body = table.concat(Chars)
        -- Keep the final message inside Roblox's 200 character chat limit
        local Affix = Affixes[Rng:NextInteger(1, #Affixes)]
        local MaxBody = 200 - (utf8.len(Affix) or #Affix)
        local BodyLength = utf8.len(Body) or #Body
        if BodyLength > MaxBody then
            Body = Body:sub(1, (utf8.offset(Body, MaxBody + 1) or (MaxBody + 1)) - 1)
        end

        return Body .. Affix
    end
    -- Received chat text can come back rich-text escaped
    function Uwu.Unescape(Text)
        Text = string.gsub(Text, "&lt;", "<")
        Text = string.gsub(Text, "&gt;", ">")
        Text = string.gsub(Text, "&quot;", '"')
        Text = string.gsub(Text, "&apos;", "'")
        Text = string.gsub(Text, "&amp;", "&")
        return Text
    end

    function Uwu.GetChannel()
        local Channels = TextChatService:FindFirstChild("TextChannels")
        if not Channels then
            return nil
        end

        local General = Channels:FindFirstChild("RBXGeneral")
        if General then
            return General
        end
        -- Some games rename or remove RBXGeneral: use any channel we're a member of
        for _, Channel in ipairs(Channels:GetChildren()) do
            if Channel:IsA("TextChannel") and Channel:FindFirstChild(LocalPlayer.Name) then
                return Channel
            end
        end

        return nil
    end
    -- Shows why something failed instead of failing silently
    function Uwu.Fail(Reason)
        warn("[MOUSED] Uwuify: " .. tostring(Reason))
        Rayfield:Notify({
            Title = "Uwuify failed",
            Content = tostring(Reason),
            Duration = 6
        })
    end
    -- Returns true, or false plus the reason it failed
    function Uwu.Send(Message)
        -- Remember messages we sent ourselves so auto mode doesn't uwuify them again
        local Tracked = Uwu.Auto
        if Tracked then
            table.insert(Uwu.Ignore, os.clock())
        end

        local Reason = "no chat channel found in this game"

        local Channel = Uwu.GetChannel()
        if Channel then
            local Ok, Err = pcall(function()
                Channel:SendAsync(Message)
            end)
            if Ok then
                return true
            end
            Reason = "SendAsync error: " .. tostring(Err)
        end
        -- Legacy chat fallback
        local Events = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        local SayMessage = Events and Events:FindFirstChild("SayMessageRequest")
        if SayMessage then
            local Ok, Err = pcall(function()
                SayMessage:FireServer(Message, "All")
            end)
            if Ok then
                return true
            end
            Reason = "legacy chat error: " .. tostring(Err)
        end

        if Tracked then
            table.remove(Uwu.Ignore)
        end
        return false, Reason
    end
    -- Uwuifies and sends, reporting any failure
    function Uwu.UwuifyAndSend(Text)
        local Built, Message = pcall(Uwu.Transform, Text)
        if not Built then
            Uwu.Fail("couldn't uwuify that: " .. tostring(Message))
            return
        end

        local Sent, Reason = Uwu.Send(Message)
        if not Sent then
            Uwu.Fail(Reason)
        end
    end

    function Uwu.OnOwnMessage(Text)
        -- Skip the echo of messages this script sent
        local Now = os.clock()
        while Uwu.Ignore[1] and Now - Uwu.Ignore[1] > 5 do
            table.remove(Uwu.Ignore, 1)
        end
        if Uwu.Ignore[1] then
            table.remove(Uwu.Ignore, 1)
            return
        end
        -- Don't touch empty messages or chat commands like /e dance
        if not Uwu.Auto or not Text:match("%S") or Text:sub(1, 1) == "/" then
            return
        end

        Uwu.UwuifyAndSend(Text)
    end

    function Uwu.SetAuto(State)
        Uwu.Auto = State
        table.clear(Uwu.Ignore)

        if Uwu.Connection then
            Uwu.Connection:Disconnect()
            Uwu.Connection = nil
        end

        if not State then
            return true
        end

        local Channel = Uwu.GetChannel()
        if Channel then
            Uwu.Connection = Channel.MessageReceived:Connect(function(Message)
                local Source = Message.TextSource
                if Source and Source.UserId == LocalPlayer.UserId then
                    Uwu.OnOwnMessage(Uwu.Unescape(Message.Text or ""))
                end
            end)
            return true
        end

        if ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents") then
            Uwu.Connection = LocalPlayer.Chatted:Connect(function(Text)
                Uwu.OnOwnMessage(Text)
            end)
            return true
        end

        Uwu.Auto = false
        return false
    end

    FunTab:CreateInput({
        Name = "Uwuify Message",
        PlaceholderText = "type a message, press enter",
        RemoveTextAfterFocusLost = true,
        Callback = function(Text)
            if not Text or not Text:match("%S") then
                return
            end

            Uwu.UwuifyAndSend(Text)
        end,
    })

    AutoToggle = FunTab:CreateToggle({
        Name = "Auto Uwuify",
        CurrentValue = false,
        Flag = "AutoUwuify",
        Callback = function(Value)
            if not Uwu.SetAuto(Value) then
                Rayfield:Notify({
                    Title = "Auto Uwuify",
                    Content = "Couldn't find a chat channel to watch.",
                    Duration = 3
                })
                if Value and AutoToggle then
                    AutoToggle:Set(false)
                end
                return
            end

            if Value then
                Rayfield:Notify({
                    Title = "Auto Uwuify",
                    Content = "On. Your original message still sends first, then the uwuified copy.",
                    Duration = 4
                })
            end
        end,
    })

    table.insert(ExtraCleanups, function()
        Uwu.SetAuto(false)
    end)
end

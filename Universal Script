local WorkspacePartName = ""
local SavedPosition = nil
local SavedPositionInput = "0, 0, 0"

local function ParseVector3String(StringValue)
    if type(StringValue) ~= "string" then
        return nil
    end

    local Clean = StringValue:gsub("%s+", "")
    local Values = {}

    for Number in Clean:gmatch("-?%d+%.?%d*") do
        table.insert(Values, tonumber(Number))
    end

    if #Values < 3 then
        return nil
    end

    return Vector3.new(Values[1], Values[2], Values[3])
end

local function GetCharacterRoot()
    local Character = LocalPlayer.Character
    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

local function SaveCurrentPosition()
    local Root = GetCharacterRoot()
    if not Root then
        return nil
    end

    SavedPosition = Root.Position
    return SavedPosition
end

local function GoToSavedPosition()
    if not SavedPosition then
        Rayfield:Notify({
            Title = "Saved Position",
            Content = "No position has been copied yet.",
            Duration = 2
        })
        return
    end

    local Root = GetCharacterRoot()
    if not Root then
        Rayfield:Notify({
            Title = "Saved Position",
            Content = "Your character is not loaded.",
            Duration = 2
        })
        return
    end

    Root.CFrame = CFrame.new(SavedPosition + Vector3.new(0, 3, 0))
end

local function TweenToSavedPosition()
    if not SavedPosition then
        Rayfield:Notify({
            Title = "Saved Position",
            Content = "No position has been copied yet.",
            Duration = 2
        })
        return
    end

    local Root = GetCharacterRoot()
    if not Root then
        Rayfield:Notify({
            Title = "Saved Position",
            Content = "Your character is not loaded.",
            Duration = 2
        })
        return
    end

    local TargetCFrame = CFrame.new(SavedPosition + Vector3.new(0, 3, 0))
    local Distance = (Root.Position - TargetCFrame.Position).Magnitude
    local Duration = math.clamp(Distance / 75, 0.2, 1.2)

    local Tween = TweenService:Create(
        Root,
        TweenInfo.new(Duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        {CFrame = TargetCFrame}
    )

    Tween:Play()
end

local function WalkToSavedPosition()
    if not SavedPosition then
        Rayfield:Notify({
            Title = "Saved Position",
            Content = "No position has been copied yet.",
            Duration = 2
        })
        return
    end

    local Character = LocalPlayer.Character
    if not Character then
        Rayfield:Notify({
            Title = "Saved Position",
            Content = "Your character is not loaded.",
            Duration = 2
        })
        return
    end

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Humanoid then
        Rayfield:Notify({
            Title = "Saved Position",
            Content = "No Humanoid found.",
            Duration = 2
        })
        return
    end

    Humanoid:MoveTo(SavedPosition)
end

local function GetWorkspacePartByName(Name)
    if not Name or Name == "" then
        return nil
    end

    local SearchName = Name:lower()

    for _, Part in ipairs(workspace:GetDescendants()) do
        if Part:IsA("BasePart") and Part.Name:lower() == SearchName then
            return Part
        end
    end

    return workspace:FindFirstChild(Name, true)
end


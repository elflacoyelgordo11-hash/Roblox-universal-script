MovementTab:CreateToggle({
    Name = "Noclip",
    CurrentValue = false,
    Callback = function(Value)
        NoclipEnabled = Value

        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end

        if NoclipDescendantConnection then
            NoclipDescendantConnection:Disconnect()
            NoclipDescendantConnection = nil
        end

        if Value then
            local function DisableCharacterCollision(Character)
                if Character then
                    for _, part in ipairs(Character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            if OriginalNoclipCanCollide[part] == nil then
                                OriginalNoclipCanCollide[part] = part.CanCollide
                            end

                            pcall(function()
                                part.CanCollide = false
                            end)
                        end
                    end
                end

            end

            NoclipConnection = RunService.Stepped:Connect(function()
                if NoclipEnabled then
                    DisableCharacterCollision(LocalPlayer.Character)
                end
            end)

            NoclipDescendantConnection = LocalPlayer.CharacterAdded:Connect(function(Character)
                DisableCharacterCollision(Character)
            end)

            DisableCharacterCollision(LocalPlayer.Character)
        else
            for part, Original in pairs(OriginalNoclipCanCollide) do
                if part and part.Parent then
                    part.CanCollide = Original
                end

                OriginalNoclipCanCollide[part] = nil
            end
        end
    end,
})


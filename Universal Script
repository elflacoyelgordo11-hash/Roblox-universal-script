local function StopSpectating()
    if not SpectatingPlayer then
        return
    end

    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

    Camera.CameraType = OriginalCameraType or Enum.CameraType.Custom
    Camera.CameraSubject = Humanoid or OriginalCameraSubject
    SpectatingPlayer = nil
    OriginalCameraSubject = nil
    OriginalCameraType = nil
end

local function StartSpectating()
    if not SelectedPlayer then
        Rayfield:Notify({
            Title = "Spectate",
            Content = "Select a player first.",
            Duration = 2
        })
        return
    end

    local Target = Players:FindFirstChild(SelectedPlayer)
    local Humanoid = Target and Target.Character
        and Target.Character:FindFirstChildOfClass("Humanoid")

    if not Humanoid then
        Rayfield:Notify({
            Title = "Spectate",
            Content = "Player or character isn't loaded.",
            Duration = 2
        })
        return
    end

    if not SpectatingPlayer then
        OriginalCameraSubject = Camera.CameraSubject
        OriginalCameraType = Camera.CameraType
    end

    SpectatingPlayer = Target
    Camera.CameraType = Enum.CameraType.Custom
    Camera.CameraSubject = Humanoid
end

RunService.RenderStepped:Connect(function()
    if not SpectatingPlayer then
        return
    end

    if not SpectatingPlayer.Parent then
        StopSpectating()
        return
    end

    local Character = SpectatingPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

    if Humanoid then
        Camera.CameraSubject = Humanoid
    else
        StopSpectating()
    end
end)


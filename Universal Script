    Name = "Infinite Jump",
    CurrentValue = false,
    Flag = "InfiniteJump",

    Callback = function(Value)
        InfiniteJump = Value
        JumpInputHeld = false

        if JumpConnection then
            JumpConnection:Disconnect()
            JumpConnection = nil
        end

        if JumpInputBeganConnection then
            JumpInputBeganConnection:Disconnect()
            JumpInputBeganConnection = nil
        end

        if JumpInputEndedConnection then
            JumpInputEndedConnection:Disconnect()
            JumpInputEndedConnection = nil
        end

        if not InfiniteJump then
            return
        end

        local function DoInfiniteJump()
            if not InfiniteJump or JumpInputHeld then
                return
            end

            local Character = LocalPlayer.Character
            local Humanoid = Character
                and Character:FindFirstChildOfClass("Humanoid")

            if Humanoid and Humanoid.Health > 0 then
                JumpInputHeld = true
                Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                Humanoid.Jump = true
            end
        end

        JumpInputBeganConnection = UserInputService.InputBegan:Connect(function(Input, GameProcessed)
            if GameProcessed then
                return
            end

            if Input.KeyCode == Enum.KeyCode.Space
                or Input.KeyCode == Enum.KeyCode.ButtonA then
                DoInfiniteJump()
            end
        end)

        JumpInputEndedConnection = UserInputService.InputEnded:Connect(function(Input)
            if Input.KeyCode == Enum.KeyCode.Space
                or Input.KeyCode == Enum.KeyCode.ButtonA
                or Input.UserInputType == Enum.UserInputType.Touch then
                JumpInputHeld = false
            end
        end)

        -- Supports mobile jump input while preventing repeated jumps while held.
        JumpConnection = UserInputService.JumpRequest:Connect(function()
            if IsMobileInput() then
                DoInfiniteJump()
            end
        end)
    end,
})

